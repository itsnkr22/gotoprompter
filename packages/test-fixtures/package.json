{
  "name": "@gotoprompter/test-fixtures",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Golden engine fixtures shared by the TypeScript (Vitest) and Swift (XCTest) suites. Spec: docs/ENGINE_SPEC.md §10.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures/*": "./fixtures/*",
    "./scenarios/*": "./scenarios/*"
  },
  "files": [
    "dist",
    "fixtures",
    "scenarios"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate": "tsc -p tsconfig.build.json && node dist/generate.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@gotoprompter/config": "workspace:*",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "@gotoprompter/prompter-core": "workspace:*"
  }
}
