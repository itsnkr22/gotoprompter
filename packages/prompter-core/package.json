{
  "name": "@gotoprompter/prompter-core",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Voice-tracking teleprompter engine (tokenizer, matcher, commands, autoscroll). No DOM. Spec: docs/ENGINE_SPEC.md.",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@gotoprompter/config": "workspace:*",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "@types/node": "^26.6.6"
  }
}
