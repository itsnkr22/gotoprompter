# apps/web — copy to .env.local for local development. All values are public (bundled into the client).

# Base URL of apps/api, used for the Google Docs proxy (GET /gdoc?id=). P3/P5.
VITE_API_BASE=http://localhost:8787

# Cookie-less analytics (Umami). Leave empty to disable. P3.
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=
