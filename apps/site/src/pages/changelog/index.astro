---
import { getCollection } from 'astro:content';
import { APP_NAME } from '../../brand';
import ChangelogTabs from '../../components/ChangelogTabs.astro';
import Base from '../../layouts/Base.astro';

const [entry] = await getCollection('changelog');
const markdown = entry?.body ?? '';
---

<Base title={`Changelog: what's new in ${APP_NAME}`} description={`Release notes for the ${APP_NAME} web app and Mac app: new features, fixes and improvements to voice scrolling, languages and recording, newest first.`}>
  <section class="container block changelog-page">
    <h1>What's new in {APP_NAME}</h1>
    <p class="muted lede">
      Every release of the <a href="/web/">free web teleprompter</a> and the <a href="/mac/">Mac app</a>, newest first. Questions about
      a change? <a href="/support/">Support</a> has answers, and the <a href="/blog/">blog</a> covers how features work.
    </p>
    <ChangelogTabs markdown={markdown} />
  </section>
</Base>

<style>
  .changelog-page {
    max-width: 48rem;
  }
  .lede {
    font-size: 1.0625rem;
  }
</style>
