---
interface Props {
  videoId: string;
  title: string;
}
const { videoId, title } = Astro.props;
---

{
  videoId && (
    <div class="container block">
      <div class="lite-yt" data-id={videoId} data-title={title}>
        <img src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`} alt={title} width="480" height="360" loading="lazy" />
        <button type="button" class="play" aria-label={`Play video: ${title}`}>
          ▶
        </button>
      </div>
    </div>
  )
}

<script is:inline>
  document.querySelectorAll('.lite-yt').forEach(function (box) {
    box.querySelector('.play').addEventListener('click', function () {
      var iframe = document.createElement('iframe');
      iframe.src = 'https://www.youtube-nocookie.com/embed/' + box.dataset.id + '?autoplay=1';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.title = box.dataset.title;
      box.replaceChildren(iframe);
    });
  });
</script>

<style>
  .lite-yt {
    position: relative;
    aspect-ratio: 16 / 9;
    max-width: 56rem;
    margin-inline: auto;
    background: #000;
    border-radius: var(--vp-radius-lg);
    overflow: hidden;
  }
  .lite-yt img,
  .lite-yt :global(iframe) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    border: 0;
    background: var(--vp-color-accent);
    color: var(--vp-color-accent-contrast);
    font-size: 1.5rem;
    cursor: pointer;
  }
</style>
