---
import { APP_NAME } from '../brand';
import DownloadMeta from './DownloadMeta';
---

<div class="card download-card">
  <DownloadMeta client:load appName={APP_NAME} />
</div>

<style>
  .download-card {
    padding: 2rem;
    max-width: 40rem;
  }
  .download-card :global(.big) {
    font-size: 1.125rem;
    padding: 0.9rem 1.75rem;
  }
  .download-card :global(.meta) {
    margin: 1rem 0 0.5rem;
  }
  .download-card :global(.sha) {
    font-size: 0.875rem;
    word-break: break-all;
  }
  .download-card :global(.small) {
    min-height: 2rem;
    padding: 0.2rem 0.7rem;
    font-size: 0.8125rem;
  }
  .download-card :global(.notes) {
    margin-top: 1rem;
  }
  .download-card :global(.notes summary) {
    cursor: pointer;
    font-weight: 600;
  }
</style>
