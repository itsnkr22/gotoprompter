{
  "name": "@gotoprompter/site",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Astro marketing site, blog, changelog, support, legal and commerce pages. Hosts the web app at /app/.",
  "scripts": {
    "prebuild": "node scripts/copy-web-app.mjs",
    "build": "astro build",
    "postbuild": "node scripts/ai-files.mjs dist && node scripts/check-links.mjs dist",
    "dev": "node scripts/copy-web-app.mjs && astro dev",
    "preview": "astro preview",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/preact": "^6.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@gotoprompter/config": "workspace:*",
    "@gotoprompter/ui-tokens": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.5",
    "marked": "^18.1.3",
    "preact": "^11.1.1",
    "satori": "^0.63.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "1.64.0",
    "node-html-parser": "^6.1.13",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  }
}
