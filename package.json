{
  "name": "gotoprompter",
  "private": true,
  "description": "Voice-following teleprompter: the free, open-source web app and its marketing site.",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gotoprompter/config": "workspace:*",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@vercel/functions": "3.10.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsnkr22/gotoprompter.git"
  }
}
